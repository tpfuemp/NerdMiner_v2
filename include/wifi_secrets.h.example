// Copy to include/wifi_secrets.h (git-ignored) to compile in default WiFi credentials.
// They are only used when no WiFi was saved via the config portal yet.
// Note: the portal still opens if no pool config (/config.json) exists, see data/config.json.example.
#define WIFI_SSID "yourWifiName"
#define WIFI_PW   "yourWifiPassword"
